---
const { section, subsection } = Astro.params;
const res = await fetch(
  `/api/articles/by-subsection?section=${section}&subsection=${subsection}`
);
const articles = await res.json();
---

<html lang="cs">
  <head>
    <link rel="stylesheet" href="/css/subsection.css">
  </head>
  <body>
    <h1 class="subsection-title">{section} / {subsection}</h1>

    <div class="articles">
      {articles.map(a => (
        <a class="article-card" href={`/${section}/${subsection}/${a.slug}/`}>
          {a.leadImage && (
            <img src={`/photos/${a.leadImage}`} class="thumb" />
          )}
          <div class="info">
            <h2>{a.title}</h2>
            <div class="meta">
              <span>{a.date}</span>
              <span>{a.place}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </body>
</html>
