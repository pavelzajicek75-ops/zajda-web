---
const { section } = Astro.params;
const res = await fetch(`/api/articles/by-section?section=${section}`);
const articles = await res.json();
---

<html lang="cs">
  <head>
    <link rel="stylesheet" href="/css/section.css">
  </head>
  <body>
    <h1 class="section-title">{section}</h1>

    <div class="articles">
      {articles.map(a => (
        <a class="article-card" href={`/${section}/${a.subsection}/${a.slug}/`}>
          {a.leadImage && (
            <img src={`/photos/${a.leadImage}`} class="thumb" />
          )}
          <div class="info">
            <h2>{a.title}</h2>
            <div class="meta">
              <span>{a.date}</span>
              <span>{a.place}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </body>
</html>
